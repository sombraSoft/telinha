{
  // The generator and the tests run under Bun. No allowJs: nothing here
  // imports astro.config.mjs (the tests read it as text).
  // jsx options: the generator imports cli/doctor.ts and cli/setup.ts, and tsc
  // follows their dynamic import() of server/src/tui/**/*.tsx, which fails with
  // TS6142 without a jsx option.
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext"],
    "module": "Preserve",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "types": ["bun"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "jsx": "preserve",
    "jsxImportSource": "@opentui/solid"
  },
  "include": ["**/*.ts"]
}
