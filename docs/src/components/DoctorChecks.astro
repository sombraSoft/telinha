---
// Check | Title | What it looks at | What fixes it, in the order the doctor runs them.
import generated from '../data/generated.json';
import { codeSegments, DOCTOR_CHECK_DOCS, type Locale, UI, type UiKey } from '../data/reference.ts';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

const checks = generated.doctor.checks as { id: string; title: Record<Locale, string> }[];
const rows = checks.map((c) => {
  const doc = DOCTOR_CHECK_DOCS[c.id];
  return { id: c.id, title: c.title[locale], looksAt: doc?.looksAt[locale] ?? '', fixes: doc?.fixes[locale] ?? '' };
});
const t = (k: UiKey) => UI[k][locale];
---

<table>
  <thead>
    <tr>
      <th>{t('check')}</th>
      <th>{t('title')}</th>
      <th>{t('looksAt')}</th>
      <th>{t('fixes')}</th>
    </tr>
  </thead>
  <tbody>
    {rows.map((r) => (
      <tr>
        <td>
          <code>{r.id}</code>
        </td>
        <td>{r.title}</td>
        <td>{codeSegments(r.looksAt).map((s, i) => (i % 2 ? <code>{s}</code> : s))}</td>
        <td>{codeSegments(r.fixes).map((s, i) => (i % 2 ? <code>{s}</code> : s))}</td>
      </tr>
    ))}
  </tbody>
</table>
