root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Shell scripts and the Caddyfile are tab-indented.
[{deploy/**.sh,deploy/ipwatch/tela-ipwatch,deploy/updater/tela-update,deploy/Caddyfile}]
indent_style = tab
