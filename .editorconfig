# CI's lint job runs editorconfig-checker against these rules. Its indent_size
# check is off (.editorconfig-checker.json): Markdown list continuations,
# comment continuation lines and test fixtures align to the text above them,
# not to steps of indent_size. The indent style (tabs or spaces) is checked.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Shell scripts are tab-indented.
[{deploy/**.sh,deploy/telinha-update,scripts/**.sh}]
indent_style = tab
