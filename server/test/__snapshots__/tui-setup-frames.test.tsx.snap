exports[`setup frames, en 120x34 a home install from the first question to the last card: review 1`] = `
"  \\ /
 ╭───╮ telinha setup                                                                                              vtest
 │•‿•│ Screen sharing for your Discord group
 ╰───╯
 ╭────────────────────────╮ ╭─ Review · Step 7 of 8 ──────────────────────────────────────────────────────────────────╮
 │ ✔ Where                │ │                                                                                         │
 │   A computer at home   │ │  Review                                                                                 │
 │                        │ │  Check your answers. Nothing has changed on this machine yet.                           │
 │ ✔ Address              │ │  They go to /opt/telinha/config/telinha.env.                                            │
 │   DuckDNS :8443        │ │                                                                                         │
 │                        │ │  Where      Where will Telinha run?               A computer at home                    │
 │ ✔ Discord              │ │  Address    Do you have a domain on Cloudflare?   No: use a free DuckDNS address        │
 │   /telinha · Gurizada  │ │             DuckDNS name                          my-group                              │
 │                        │ │             DuckDNS token                         set                                   │
 │ ✔ Video                │ │             HTTPS port                            8443                                  │
 │   this computer        │ │             Web address                           https://my-group.duckdns.org:8443     │
 │                        │ │  Discord    Discord bot token                     set                                   │
 │ ✔ Ports                │ │             Client secret                         set                                   │
 │   TCP 7881, 8443       │ │             Which Discord server?                 Gurizada                              │
 │   UDP 7882             │ │             Who may enter the rooms?              @Membro                               │
 │                        │ │             Where does the command work?          #telinha                              │
 │ ✔ Updates              │ │             Command name                          telinha                               │
 │   automatic            │ │             Group name                            Gurizada                              │
 │                        │ │  Video      Video                                 This computer                         │
 │ ❯ Review               │ │    ↓ 3 more                                                                             │
 │                        │ │                                                                                         │
 │ ○ Install              │ │  ❯ 1. Apply                                                                             │
 │                        │ │       Write telinha.env, install and start Telinha                                      │
