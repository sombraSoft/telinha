exports[`setup frames, en 120x34 a home install from the first question to the last card: where 1`] = `
"  \\ /
 ╭───╮ telinha setup                                                                                              vtest
 │•‿•│ Screen sharing for your Discord group
 ╰───╯
 ╭────────────────────────╮ ╭─ Where · Step 1 of 8 ───────────────────────────────────────────────────────────────────╮
 │ ❯ Where                │ │                                                                                         │
 │                        │ │  Where will Telinha run?                                                                │
 │ ○ Address              │ │  Pick the machine that stays on and hosts the rooms.                                    │
 │                        │ │                                                                                         │
 │ ○ Discord              │ │  ❯ 1. A computer at home                                                                │
 │                        │ │       Your PC or another machine at home, behind your internet router                   │
 │ ○ Video                │ │    2. A rented machine (VPS)                                                            │
 │                        │ │       Hetzner, DigitalOcean, Oracle Cloud and the like: it has its own public IP        │
 │ ○ Ports                │ │                                                                                         │
 │                        │ ╰─────────────────────────────────────────────────────────────────────────────────────────╯
 │ ○ Updates              │ ╭─ About this ────────────────────────────────────────────────────────────────────────────╮
 │                        │ │ Good for a group of friends: Telinha runs on a machine you already have.                │
 │ ○ Review               │ │                                                                                         │
 │                        │ │ Home internet connections usually do not let the web ports 80 and 443 in, so Telinha    │
 │ ○ Install              │ │ does not count on them. Next you pick how people reach this machine: a Cloudflare       │
 │                        │ │ Tunnel (if you have a domain on Cloudflare) or a free DuckDNS address with HTTPS on     │
 ╰────────────────────────╯ │ port 8443.                                                                              │
                            │                                                                                         │
                            │ This machine: Debian GNU/Linux 12 (bookworm), x64, public IP 203.0.113.9.               │
                            │ Router: Fritz!Box (UPnP IGD v2, 192.168.0.1).                                           │
                            ╰─────────────────────────────────────────────────────────────────────────────────────────╯







 ↑↓ move  1-9 pick  enter select  esc/← back  tab steps  ctrl+c quit
"
`;

exports[`setup frames, en 120x34 a home install from the first question to the last card: home-cloudflare 1`] = `
"  \\ /
 ╭───╮ telinha setup                                                                                              vtest
 │•‿•│ Screen sharing for your Discord group
 ╰───╯
 ╭────────────────────────╮ ╭─ Address · Step 2 of 8 ─────────────────────────────────────────────────────────────────╮
 │ ✔ Where                │ │                                                                                         │
 │   A computer at home   │ │  Do you have a domain on Cloudflare?                                                    │
 │                        │ │  Home internet connections usually do not let the web ports 80 and 443 in, so Telinha   │
 │ ❯ Address              │ │  does not count on them.                                                                │
 │                        │ │                                                                                         │
 │ ○ Discord              │ │    1. Yes: use a Cloudflare Tunnel                                                      │
 │                        │ │       Your own address; nothing to open for the pages                                   │
 │ ○ Video                │ │  ❯ 2. No: use a free DuckDNS address                                                    │
 │                        │ │       Like https://name.duckdns.org:8443                                                │
 │ ○ Ports                │ │                                                                                         │
 │                        │ │    3. Advanced…                                                                         │
 │ ○ Updates              │ │       I opened 80/443 myself, or I run my own reverse proxy                             │
 │                        │ │                                                                                         │
 │ ○ Review               │ ╰─────────────────────────────────────────────────────────────────────────────────────────╯
 │                        │ ╭─ About this ────────────────────────────────────────────────────────────────────────────╮
 │ ○ Install              │ │ You get https://<name>.duckdns.org:8443. The certificate comes from Let's Encrypt       │
 │                        │ │ through your DuckDNS token (DNS-01): nothing to open on 80 or 443.                      │
 ╰────────────────────────╯ │                                                                                         │
                            │ Some strict networks (offices, schools) only let browsers reach port 443, so people     │
                            │ there cannot open the links; a domain on Cloudflare has no such limit.                  │
                            │                                                                                         │
                            │ You need a free duckdns.org account and its token.                                      │
                            ╰─────────────────────────────────────────────────────────────────────────────────────────╯





 ↑↓ move  1-9 pick  enter select  esc/← back  tab steps  ctrl+c quit
"
`;

