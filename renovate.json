{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "group:allNonMajor"],
  "timezone": "America/Sao_Paulo",
  "schedule": ["* 0-3 * * 1"],
  "dependencyDashboard": true,
  "semanticCommits": "enabled",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["* 0-3 1 * *"]
  },
  "packageRules": [
    {
      "description": "Non-major updates merge themselves once the required checks pass",
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "LiveKit (client, server SDK, SFU) must move together and be tested by hand: own group, never automerged",
      "matchPackageNames": ["livekit-client", "livekit-server-sdk", "livekit/livekit-server"],
      "groupName": "livekit",
      "automerge": false
    },
    {
      "description": "Majors are reviewed by hand",
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "description": "The Dockerfile and compose.yml ship in the image or the release tag, so their bumps must cut a release",
      "matchManagers": ["dockerfile", "docker-compose"],
      "semanticCommitType": "fix"
    }
  ]
}
