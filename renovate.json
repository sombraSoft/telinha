{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "group:allNonMajor"],
  "timezone": "America/Sao_Paulo",
  "schedule": ["* 0-3 * * 1"],
  "dependencyDashboard": true,
  "semanticCommits": "enabled",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["* 0-3 1 * *"]
  },
  "customManagers": [
    {
      "description": "LiveKit server binary pinned in versions.json (run `bun scripts/versions.ts refresh` after a bump)",
      "customType": "regex",
      "managerFilePatterns": ["/^versions\\.json$/"],
      "matchStrings": ["\"livekit\":\\s*\\{\\s*\"version\":\\s*\"(?<currentValue>[^\"]+)\""],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "livekit/livekit",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "description": "Caddy binary pinned in versions.json (run `bun scripts/versions.ts refresh` after a bump)",
      "customType": "regex",
      "managerFilePatterns": ["/^versions\\.json$/"],
      "matchStrings": ["\"caddy\":\\s*\\{\\s*\"version\":\\s*\"(?<currentValue>[^\"]+)\""],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "caddyserver/caddy",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "description": "cloudflared binary pinned in versions.json (run `bun scripts/versions.ts refresh` after a bump); its tags have no v prefix",
      "customType": "regex",
      "managerFilePatterns": ["/^versions\\.json$/"],
      "matchStrings": ["\"cloudflared\":\\s*\\{\\s*\"version\":\\s*\"(?<currentValue>[^\"]+)\""],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "cloudflare/cloudflared"
    }
  ],
  "packageRules": [
    {
      "description": "Non-major updates merge themselves once the required checks pass",
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "LiveKit (client, server SDK, SFU) must move together and be tested by hand: own group, never automerged",
      "matchPackageNames": ["livekit-client", "livekit-server-sdk", "livekit/livekit"],
      "groupName": "livekit",
      "automerge": false
    },
    {
      "description": "Bumps in versions.json stay red until someone runs `bun scripts/versions.ts refresh`, so they never automerge or block the allNonMajor group",
      "matchDepNames": ["caddyserver/caddy", "cloudflare/cloudflared"],
      "groupName": "child-binaries",
      "automerge": false
    },
    {
      "description": "Majors are reviewed by hand",
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "description": "The Dockerfile and compose.yml ship in the image or the release tag, so their bumps must cut a release",
      "matchManagers": ["dockerfile", "docker-compose"],
      "semanticCommitType": "fix"
    },
    {
      "description": "versions.json pins the binaries baked into the image, so its bumps must cut a release",
      "matchFileNames": ["versions.json"],
      "semanticCommitType": "fix"
    }
  ]
}
