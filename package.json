{
  "name": "telinha",
  "private": true,
  "version": "0.6.0",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "server",
    "web",
    "docs"
  ],
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "build": "bun run --filter @telinha/web build",
    "docs:dev": "bun run --filter @telinha/docs dev",
    "docs:build": "bun run --filter @telinha/docs build",
    "test": "bun test ./server ./web ./docs ./scripts",
    "typecheck": "bun run --filter '*' typecheck && tsc --noEmit -p .",
    "e2e": "playwright test",
    "compile": "bun scripts/build-binary.ts",
    "image": "bun scripts/image.ts",
    "bins": "bun scripts/bins.ts",
    "caddy": "bun scripts/caddy-build.ts",
    "versions": "bun scripts/versions.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/bun": "^1.4.2",
    "typescript": "^6.0.3"
  }
}
