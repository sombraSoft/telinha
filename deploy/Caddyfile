# Only reachable from cloudflared on this host (Cloudflare Tunnel -> 127.0.0.1:8080).
# Every request except /auth/* must pass Telinha's Discord login + role check.
# /healthz on telinha is never routed here: it falls into the gated catch-all.
{
	admin off
	auto_https off
}

:8080 {
	bind 127.0.0.1

	handle /auth/* {
		reverse_proxy 127.0.0.1:8081
	}

	handle {
		forward_auth 127.0.0.1:8081 {
			uri /auth/check
		}
		route {
			# LiveKit signaling (WebSocket); media goes direct over tcp 7891 / udp 7892
			handle_path /livekit/* {
				reverse_proxy 127.0.0.1:7880
			}
			# Telinha's room page
			handle /sala* {
				reverse_proxy 127.0.0.1:8081
			}
			# Anything else (old Screego links like /?room=x) -> the room page
			handle {
				redir * /sala/?{query} 302
			}
		}
	}
}
