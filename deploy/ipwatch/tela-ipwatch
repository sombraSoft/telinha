#!/bin/sh
# LiveKit resolves the public IP once at start (STUN) and advertises it in ICE
# candidates. When the residential IP changes, restart livekit so streams keep
# working. Installed to /usr/local/sbin by deploy/install.sh.
set -eu
# compose.yml and the .env holding TELINHA_VERSION both live here
dir=/opt/bots/tela/deploy
state=/var/lib/tela-ipwatch-ip
ip=$(curl -fsS -m 10 https://1.1.1.1/cdn-cgi/trace | sed -n "s/^ip=//p")
case "$ip" in *.*.*.*) ;; *) exit 0 ;; esac
old=$(cat "$state" 2>/dev/null || true)
[ "$ip" = "$old" ] && exit 0
# first run: just remember the IP
if [ -z "$old" ]; then
	echo "$ip" > "$state"
	exit 0
fi
logger -t tela-ipwatch "public IP $old -> $ip, restarting livekit"
# Save the new IP only once the restart worked, so a failure is retried next tick.
if (cd "$dir" && docker compose restart livekit >/dev/null 2>&1); then
	echo "$ip" > "$state"
else
	logger -t tela-ipwatch "livekit restart failed, will retry"
	exit 1
fi
