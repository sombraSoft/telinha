# Telinha (login gate, room page + /telinha). Copy to /etc/telinha/app.env, fill in, chmod 600. Never commit or paste these.
# discord.com/developers -> Telinha app -> Bot -> Reset Token; on the same page switch on
# Server Members Intent and Presence Intent (the member list needs both)
DISCORD_TOKEN=
# OAuth2 page: Client ID + Client Secret. Add redirect https://tela.example.com/auth/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# random, generated on the server: openssl rand -base64 48
COOKIE_SECRET=
GUILD_ID=<your server id>
# members with this role may enter
ROLE_ID=<role id>
# /telinha only in these channels (comma separated)
CHANNEL_IDS=<channel id>
PUBLIC_URL=https://tela.example.com
# keep the port in sync with the healthcheck in compose.yml and the Caddyfile
LISTEN=127.0.0.1:8081
SESSION_DAYS=7
ROLE_CACHE_SECONDS=300
# LiveKit (same pair as livekit.env LIVEKIT_KEYS="<key>: <secret>")
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Optional: group name shown in pages and /telinha (e.g. "Crew"); default = the Discord server's name
#GROUP_NAME=<group name>
# Optional: WebSocket URL browsers use for LiveKit signaling; default = PUBLIC_URL as wss:// + /livekit
#LIVEKIT_PUBLIC_URL=wss://tela.example.com/livekit
# Optional: LiveKit HTTP API the server calls to create, list and close rooms; default http://127.0.0.1:7880
#LIVEKIT_API_URL=http://127.0.0.1:7880
# Optional: a /telinha room closes for good after this many seconds with nobody in it (also counted from
# /telinha when nobody ever joins); default 300. POLL_SECONDS: how often rooms are checked; default 5.
#CLOSE_EMPTY_SECONDS=300
#POLL_SECONDS=5
# Optional: where the room registry (telinha.sqlite) lives; the image sets /data (the telinha-data volume)
#DATA_DIR=/data
# DEV_USER (fake login) is for local dev only: never set it here. The server
# refuses to start with it unless PUBLIC_URL is http://localhost or http://127.0.0.1.
