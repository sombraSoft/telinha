# Telinha (login gate + /tela). Copy to /etc/telinha/app.env, fill in, chmod 600. Never commit or paste these.
# discord.com/developers -> Telinha app -> Bot -> Reset Token
DISCORD_TOKEN=
# OAuth2 page: Client ID + Client Secret. Add redirect https://tela.example.com/auth/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# random, generated on the server: openssl rand -base64 48
COOKIE_SECRET=
GUILD_ID=<your server id>
# members with this role may enter
ROLE_ID=<role id>
# /tela only in these channels (comma separated)
CHANNEL_IDS=<channel id>
PUBLIC_URL=https://tela.example.com
# keep the port in sync with the healthcheck in compose.yml and the Caddyfile
LISTEN=127.0.0.1:8081
SESSION_DAYS=7
ROLE_CACHE_SECONDS=300
# LiveKit (same pair as livekit.env LIVEKIT_KEYS="<key>: <secret>")
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
